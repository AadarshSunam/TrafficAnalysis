# .env.example
# DB
POSTGRES_DB=smartparking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Itsmylife@123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=replace_this_with_a_secret_in_prod
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=redis://redis:6379/1

# App
APP_USER=django
APP_PORT=8000

# Optional auto-create superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=aadarshsunam4@gmail.com
DJANGO_SUPERUSER_PASSWORD=admin@123

# Email (Gmail SMTP example — see notes after)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=aadarshsunam4@gmail.com
EMAIL_HOST_PASSWORD=nytr tgzl yyev gvhx
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=aadarshsunam4@gmail.com